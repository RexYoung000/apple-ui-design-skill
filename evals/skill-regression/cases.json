      "owner_skill": "apple-ui-direction",
      "scenario_type": "direct",
      "request": "Use $apple-ui-direction to create two materially different visible directions for the FieldNotes Today screen and explain the evidence limit of each.",
      "fixture_paths": ["evals/skill-regression/fixtures/direction-product.md"],
      "expected_route": {
        "must_load": ["apple-ui-direction"],
        "must_not_load": ["apple-platform-adaptation", "apple-ui-review"]
      },
      "output_assertions": {
        "required_all": ["(?i)(evidence|证据)", "(?i)(render|visible|画面|渲染)"],
        "required_any": [
          ["(?i)(two|2|两套|两个).*(direction|方向)", "(?i)(direction|方向).*(a|b|甲|乙)"],
          ["(?i)(user acceptance|用户验收|user selection|用户选择)", "(?i)(proposed|提案|待确认)"]
        ],
        "forbidden": ["(?i)(experience verified|体验已验证)\\s*[。.!]?$", "(?i)(user accepted|用户已验收)\\s*[。.!]?$"]
      },
      "behavior": {
        "must_do": ["Produce or explicitly stop for rendered comparison artifacts.", "Keep unselected direction and native behavior unverified."],
        "must_not_do": ["Finish with a prose mood board.", "Claim user selection or native verification."]
      }
    },
